{
  "name": "eventnest-devops",
  "version": "1.0.0",
  "description": "Event registration and booking platform designed for a Jenkins DevOps pipeline demonstration.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --coverage --ci --reporters=default --reporters=jest-junit",
    "audit:high": "npm audit --audit-level=high",
    "sonar": "sonar-scanner"
  },
  "keywords": [
    "jenkins",
    "devops",
    "express",
    "events",
    "monitoring"
  ],
  "author": "Mitesh Kumar E M",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "prom-client": "^15.1.3",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "jest-junit": "^17.0.0",
    "sonar-scanner": "^3.1.0",
    "supertest": "^7.1.1"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/alertReceiver.js"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura"
    ]
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml"
  }
}
